local opened,ready=false,false
local function showFab()
    fab.Visible=true; fab.Size=UDim2.new(0,0,0,0)
    tween(fab,0.5,{Size=UDim2.new(0,FAB,0,FAB)},Enum.EasingStyle.Back)
end
local function hideFab()
    tween(fab,0.2,{Size=UDim2.new(0,0,0,0)},Enum.EasingStyle.Quint,Enum.EasingDirection.In)
    task.delay(0.22,function() if opened then fab.Visible=false end end)
end
local function setOpen(v)
    if opened==v then return end
    opened=v
    local base=baseScale()
    if v then
        sfx("open"); hideFab()
        win.Visible=true; winScale.Scale=base*0.85; win.GroupTransparency=1
        tween(winScale,0.55,{Scale=base},Enum.EasingStyle.Back)
        tween(win,0.35,{GroupTransparency=0})
        sweep.Visible=true; sweep.Position=UDim2.new(1,0,0,0)
        tween(sweep,0.9,{Position=UDim2.new(-0.25,0,0,0)},Enum.EasingStyle.Sine,Enum.EasingDirection.InOut)
        task.delay(0.95,function() sweep.Visible=false end)
        if current then
            for i,card in ipairs(current.cards) do
                card.GroupTransparency=1
                task.delay(0.15+(i-1)*0.06,function() tween(card,0.45,{GroupTransparency=0}) end)
            end
        end
    else
        sfx("close")
        tween(winScale,0.28,{Scale=base*0.88},Enum.EasingStyle.Quint,Enum.EasingDirection.In)
        tween(win,0.28,{GroupTransparency=1})
        task.delay(0.3,function()
            if not opened then win.Visible=false; showFab() end
        end)
    end
end
