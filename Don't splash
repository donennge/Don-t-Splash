----------------------------------------------------------------------
-- DON'T SPLASH BACKEND (Brandon's Logic)
----------------------------------------------------------------------
local state = {
    players = false,
    monsters = false,
    items = false,
    safe = false,
    vaults = false
}

local tagged = {}
local vaultBillboards = {}
local platformMarks = {}

local function tagPlatform(inst)
    if platformMarks[inst] then return end
    local part = inst:IsA('BasePart') and inst or (inst:IsA('Model') and inst:FindFirstChildWhichIsA('BasePart',true))
    if not part then return end
    local adorn = Instance.new('BoxHandleAdornment')
    adorn.Name='BDH_PlatformESP'
    adorn.Adornee=part
    adorn.Size=part.Size + Vector3.new(.08,.08,.08)
    adorn.Color3=Color3.fromRGB(65,255,145)
    adorn.Transparency=.65
    adorn.AlwaysOnTop=true
    adorn.ZIndex=1
    adorn.Parent=marks
    platformMarks[inst]=adorn
end

local ITEM_COLOR=Color3.fromRGB(255,30,235)
local ITEM_OUTLINE=Color3.fromRGB(25,0,35)

local function tag(inst,color,label)
    if tagged[inst] then return end
    local h=Instance.new('Highlight')
    h.Name='BDHHighlight'
    h.FillColor=color
    h.OutlineColor=(label=='Possible item') and ITEM_OUTLINE or color
    h.FillTransparency=(label=='Possible item') and .28 or .75
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    h.Adornee=inst
    h.Parent=marks
    tagged[inst]={highlight=h,label=label}
end

local function clearTags()
    for _,v in pairs(tagged)do if v.highlight then v.highlight:Destroy()end end
    table.clear(tagged)
    for _,a in pairs(platformMarks) do pcall(function() a:Destroy() end) end
    table.clear(platformMarks)
    for _,b in ipairs(vaultBillboards) do pcall(function() b:Destroy() end) end
    table.clear(vaultBillboards)
end

local monsterWords={'monster','creature','entity','beast','hunter','locust'}
local itemWords={'pebble','rock','bottle','flare','battery','key','tool','pickup','collectible','rope','toy'}
local platformWords={'platform','pad','tile','step','sinking','spinner','spinplatform','collapse','temporary'}

local function match(name,words)
    local s=string.lower(name)
    for _,w in ipairs(words) do if s:find(w,1,true) then return true end end
    return false
end

local function isPlatform(inst)
    if not inst:IsA('BasePart') then return false end
    if LP.Character and inst:IsDescendantOf(LP.Character) then return false end
    if inst.Size.X<1.5 or inst.Size.Z<1.5 or inst.Size.Y>16 then return false end
    local parent=inst.Parent
    local name=string.lower(inst.Name..' '..(parent and parent.Name or ''))
    if match(name,platformWords) then return true end
    for k,v in pairs(inst:GetAttributes()) do
        local key=string.lower(tostring(k))
        if key=='cansink' or key=='issinking' or key=='sinking' or key=='issafe' or key=='stable' or key=='platform' or key=='isplatform' then
            return true
        end
    end
    return false
end

local function vaultPrompt(inst)
    if not inst:IsA('ProximityPrompt') then return false end
    local words=string.lower((inst.ActionText or '')..' '..(inst.ObjectText or '')..' '..(inst.Parent and inst.Parent.Name or ''))
    return words:find('valve',1,true) or words:find('maintenance control',1,true)
end

local function vaultTarget(prompt)
    local node=prompt.Parent
    if not node then return nil end
    local fallback=node
    for i=1,4 do
        if not node or node==Workspace then break end
        if node:IsA('Model') and node:FindFirstChildWhichIsA('BasePart',true) then return node end
        if node:IsA('BasePart') then fallback=node end
        node=node.Parent
    end
    return fallback
end

local function vaultStatus(prompt)
    local txt=string.lower((prompt.ActionText or '')..' '..(prompt.ObjectText or ''))
    if not prompt.Enabled or txt:find('close valve',1,true) then return 'activated' end
    if txt:find('open valve',1,true) then return 'available' end
    return 'unknown'
end

local function labelVault(target,prompt,mode)
    local anchor=target:IsA('BasePart') and target or target:FindFirstChildWhichIsA('BasePart',true)
    if not anchor then return end
    local bb=Instance.new('BillboardGui')
    bb.Name='BDH_VaultLabel';bb.Adornee=anchor;bb.AlwaysOnTop=true;bb.Size=UDim2.fromOffset(170,36)
    bb.StudsOffsetWorldSpace=Vector3.new(0,math.max(anchor.Size.Y/2+2,3),0);bb.Parent=marks
    local root=LP.Character and LP.Character:FindFirstChild('HumanoidRootPart')
    local distance=root and math.floor((root.Position-anchor.Position).Magnitude+0.5)
    local label=txt(bb,'VAULT • '..string.upper(mode)..(distance and (' • '..distance..' studs') or ''),12,UDim2.new(),UDim2.fromScale(1,1))
    label.TextXAlignment=Enum.TextXAlignment.Center
    label.TextColor3=mode=='available' and Color3.fromRGB(255,105,105) or mode=='activated' and Color3.fromRGB(80,245,150) or Color3.fromRGB(220,220,220)
    table.insert(vaultBillboards,bb)
end

local lastScan=0
RunService.Heartbeat:Connect(function(dt)
    if not gui.Parent then return end
    if os.clock()-lastScan < 1.5 then return end
    lastScan=os.clock()
    clearTags()
    
    if state.players then 
        for _,p in ipairs(Players:GetPlayers())do 
            if p~=LP and p.Character then tag(p.Character,Color3.fromRGB(70,210,255),'Player')end 
        end 
    end
    
    if not (state.monsters or state.items or state.safe or state.vaults) then return end
    local count=0
    local seenVaults={}
    
    for _,inst in ipairs(Workspace:GetDescendants())do
        count+=1; if count>18000 then break end
        
        if state.vaults and vaultPrompt(inst) then
            local target=vaultTarget(inst)
            if target and not seenVaults[target] then
                seenVaults[target]=true
                local mode=vaultStatus(inst)
                local color=mode=='available' and Color3.fromRGB(255,85,85) or mode=='activated' and Color3.fromRGB(70,245,140) or Color3.fromRGB(190,190,190)
                tag(target,color,'Vault '..mode)
                labelVault(target,inst,mode)
            end
        end
        
        if state.monsters and inst:IsA('Model') and not Players:GetPlayerFromCharacter(inst) and match(inst.Name,monsterWords) and (inst:FindFirstChildOfClass('Humanoid') or inst.PrimaryPart or inst:FindFirstChildWhichIsA('BasePart')) then
            tag(inst,Color3.fromRGB(255,75,105),'Possible monster')
        elseif state.items and (inst:IsA('Tool') or inst:IsA('Model') or inst:IsA('BasePart')) and match(inst.Name,itemWords) and not (LP.Character and inst:IsDescendantOf(LP.Character)) then
            tag(inst,ITEM_COLOR,'Possible item')
        elseif state.safe and isPlatform(inst) then
            tagPlatform(inst)
        end
    end
end)

